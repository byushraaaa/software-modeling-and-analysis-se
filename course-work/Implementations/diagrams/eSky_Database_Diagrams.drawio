ss DimDate {\n    &lt;&lt;dimension&gt;&gt;\n    +int date_key PK\n    +date full_date\n    +int day_of_month\n    +string month_name\n    +int quarter\n    +int calendar_year\n    +string day_of_week\n  }\n  class DimCustomer {\n    &lt;&lt;dimension&gt;&gt;\n    +int customer_key PK\n    +int customer_id NK\n    +string full_name\n    +string email\n    +string country_code\n    +string customer_segment\n  }\n  class DimDestination {\n    &lt;&lt;dimension&gt;&gt;\n    +int destination_key PK\n    +int destination_id NK\n    +string city_name\n    +string country_name\n    +string region\n    +string airport_code\n  }\n  class DimCurrency {\n    &lt;&lt;dimension&gt;&gt;\n    +int currency_key PK\n    +string currency_code NK\n    +string currency_name\n    +decimal exchange_rate_eur\n    +int decimal_places\n  }\n  class DimStatus {\n    &lt;&lt;dimension&gt;&gt;\n    +int status_key PK\n    +string status_type\n    +string status_code NK\n    +string status_name\n    +boolean is_final\n  }\n  class DimService {\n    &lt;&lt;dimension&gt;&gt;\n    +int service_key PK\n    +int service_id NK\n    +string service_name\n    +string service_category\n    +string description\n  }\n  class DimSupplier {\n    &lt;&lt;dimension&gt;&gt;\n    +int supplier_key PK\n    +int supplier_id NK\n    +string supplier_name\n    +string supplier_type\n    +string country_code\n  }\n  class FactBooking {\n    &lt;&lt;fact&gt;&gt;\n    +int booking_fact_key PK\n    +int booking_id DD\n    +int booking_date_key FK\n    +int customer_key FK\n    +int destination_key FK\n    +int currency_key FK\n    +int status_key FK\n    +int booking_count\n    +int passenger_count\n    +decimal booking_amount\n  }\n  class FactPayment {\n    &lt;&lt;fact&gt;&gt;\n    +int payment_fact_key PK\n    +int payment_id DD\n    +int payment_date_key FK\n    +int customer_key FK\n    +int destination_key FK\n    +int currency_key FK\n    +int status_key FK\n    +int payment_count\n    +decimal payment_amount\n    +decimal refund_amount\n  }\n  class FactServiceSale {\n    &lt;&lt;fact&gt;&gt;\n    +int service_sale_key PK\n    +int booking_id DD\n    +int sale_date_key FK\n    +int customer_key FK\n    +int destination_key FK\n    +int currency_key FK\n    +int status_key FK\n    +int service_key FK\n    +int supplier_key FK\n    +int quantity\n    +decimal gross_amount\n    +decimal discount_amount\n    +decimal net_amount\n  }\n  DimDate \&quot;1\&quot; --&gt; \&quot;0..*\&quot; FactBooking : booking date\n  DimDate \&quot;1\&quot; --&gt; \&quot;0..*\&quot; FactPayment : payment date\n  DimDate \&quot;1\&quot; --&gt; \&quot;0..*\&quot; FactServiceSale : sale date\n  DimCustomer \&quot;1\&quot; --&gt; \&quot;0..*\&quot; FactBooking : customer\n  DimCustomer \&quot;1\&quot; --&gt; \&quot;0..*\&quot; FactPayment : customer\n  DimCustomer \&quot;1\&quot; --&gt; \&quot;0..*\&quot; FactServiceSale : customer\n  DimDestination \&quot;1\&quot; --&gt; \&quot;0..*\&quot; FactBooking : destination\n  DimDestination \&quot;1\&quot; --&gt; \&quot;0..*\&quot; FactPayment : destination\n  DimDestination \&quot;1\&quot; --&gt; \&quot;0..*\&quot; FactServiceSale : destination\n  DimCurrency \&quot;1\&quot; --&gt; \&quot;0..*\&quot; FactBooking : currency\n  DimCurrency \&quot;1\&quot; --&gt; \&quot;0..*\&quot; FactPayment : currency\n  DimCurrency \&quot;1\&quot; --&gt; \&quot;0..*\&quot; FactServiceSale : currency\n  DimStatus \&quot;1\&quot; --&gt; \&quot;0..*\&quot; FactBooking : booking status\n  DimStatus \&quot;1\&quot; --&gt; \&quot;0..*\&quot; FactPayment : payment status\n  DimStatus \&quot;1\&quot; --&gt; \&quot;0..*\&quot; FactServiceSale : line status\n  DimService \&quot;1\&quot; --&gt; \&quot;0..*\&quot; FactServiceSale : service\n  DimSupplier \&quot;1\&quot; --&gt; \&quot;0..*\&quot; FactServiceSale : supplier&quot;,&#xA;  &quot;config&quot;: null,&#xA;  &quot;version&quot;: &quot;12&quot;&#xA;}" id="IRYA6rN1hvv8QuuLSa3f-1"><mxCell connectable="0" parent="1" style="gro