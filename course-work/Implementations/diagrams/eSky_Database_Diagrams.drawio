LIGHT : departure_point\n  AIRPORT ||--o{ FLIGHT : arrival_point\n  BOOKING ||--o{ BOOKING_HOTEL : includes\n  HOTEL ||--o{ BOOKING_HOTEL : selected_for\n  ROOM_TYPE ||--o{ BOOKING_HOTEL : booked_as\n  HOTEL ||--|{ ROOM_TYPE : offers\n  DESTINATION ||--o{ AIRPORT : serves\n  DESTINATION ||--o{ HOTEL : contains\n  BOOKING ||--o{ PAYMENT : paid_by\n  CURRENCY ||--o{ PAYMENT : denominates\n  CURRENCY ||--o{ BOOKING : priced_in\n  BOOKING ||--o{ BOOKING_SERVICE : adds\n  ADDITIONAL_SERVICE ||--o{ BOOKING_SERVICE : selected_as\n\n  CUSTOMER {\n    int customer_id PK\n    string first_name\n    string last_name\n    string email UK\n    string phone\n    date created_at\n    string preferred_language\n  }\n  PASSENGER {\n    int passenger_id PK\n    string first_name\n    string last_name\n    date date_of_birth\n    string passport_number\n    string nationality\n    string passenger_type\n  }\n  BOOKING {\n    int booking_id PK\n    int customer_id FK\n    int currency_id FK\n    string booking_reference UK\n    datetime created_at\n    date departure_date\n    date return_date\n    string booking_status\n    decimal total_amount\n  }\n  BOOKING_PASSENGER {\n    int booking_id PK, FK\n    int passenger_id PK, FK\n    string passenger_role\n    decimal passenger_price\n  }\n  BOOKING_FLIGHT {\n    int booking_flight_id PK\n    int booking_id FK\n    int flight_id FK\n    string leg_type\n    decimal ticket_price\n    string cabin_class\n  }\n  FLIGHT {\n    int flight_id PK\n    int airline_id FK\n    int departure_airport_id FK\n    int arrival_airport_id FK\n    string flight_number\n    datetime departure_time\n    datetime arrival_time\n    decimal base_price\n    string fare_class\n  }\n  AIRLINE {\n    int airline_id PK\n    string airline_name\n    string iata_code UK\n    string country\n  }\n  AIRPORT {\n    int airport_id PK\n    int destination_id FK\n    string airport_name\n    string iata_code UK\n    string timezone\n  }\n  BOOKING_HOTEL {\n    int booking_hotel_id PK\n    int booking_id FK\n    int hotel_id FK\n    int room_type_id FK\n    date check_in\n    date check_out\n    int room_count\n    decimal stay_price\n  }\n  HOTEL {\n    int hotel_id PK\n    int destination_id FK\n    string hotel_name\n    string address\n    int star_rating\n    decimal review_score\n    string contact_phone\n  }\n  ROOM_TYPE {\n    int room_type_id PK\n    int hotel_id FK\n    string room_name\n    int max_occupancy\n    string board_basis\n    decimal nightly_price\n  }\n  PAYMENT {\n    int payment_id PK\n    int booking_id FK\n    int currency_id FK\n    datetime payment_date\n    decimal amount\n    string payment_method\n    string payment_status\n    string transaction_reference\n  }\n  BOOKING_SERVICE {\n    int booking_service_id PK\n    int booking_id FK\n    int service_id FK\n    int quantity\n    decimal unit_price\n    string service_status\n  }\n  ADDITIONAL_SERVICE {\n    int service_id PK\n    string service_name\n    string service_category\n    string description\n    decimal default_price\n    string provider_name\n  }\n  CURRENCY {\n    int currency_id PK\n    string currency_code UK\n    string currency_name\n    int decimal_places\n  }\n  DESTINATION {\n    int destination_id PK\n    string city_name\n    string country_name\n    string country_code\n    string region\n  }&quot;,&#xA;  &quot;config&quot;: null,&#xA;  &quot;version&quot;: &quot;12&quot;&#xA;}" id="KTxlPtMbTP5lzYfYqaid-1"><mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1"><mxGeometry as="geometry" /></mxCell></UserObject><UserObject label="CUSTOMER" mermaidId="n:CUSTOMER" mermaidBaseStyle="shape=table;startSize=39.75;container=1;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=1;fontSize=16;fontFamily=Recursive;strokeWidth=2;align=center;resizeLast=1;html=1;fillColor=#FDF4FF;strokeColor=#E879F9;fontColor=#28253D;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOf